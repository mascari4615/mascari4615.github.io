  "randomgen.t04": "<div class=\"randomgen-row randomgen-row-main\"><button class=\"btn btn-primary randomgen-gen-btn\" id=\"randomGenBtn\">引く</button></div>",
  "randomgen.t05": "<button type=\"button\" class=\"randomgen-icon-btn\" id=\"randomTopicBtn\" title=\"テーマを選ぶ\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83\"/></svg><span class=\"randomgen-topic-label\" id=\"randomTopicLabel\">すべて</span></button>",
  "randomgen.t06": "<button type=\"button\" class=\"randomgen-icon-btn\" id=\"randomNoDupBtn\" title=\"重複なし\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 6h16M4 12h10M4 18h6\"/></svg></button>",
  "randomgen.t07": "<button type=\"button\" class=\"randomgen-icon-btn\" id=\"randomStoryBtn\" title=\"物語を作る\" style=\"display:none;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"/><path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\"/><path d=\"M8 7h8\"/><path d=\"M8 11h8\"/></svg></button>",
  "randomgen.t08": "<button type=\"button\" class=\"randomgen-icon-btn\" id=\"randomCopyBtn\" title=\"キーワードを全部コピー\" style=\"display:none;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg></button>",
  "randomgen.t09": "<button type=\"button\" class=\"randomgen-icon-btn\" id=\"randomInfoBtn\" title=\"出典\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"16\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"8\" x2=\"12.01\" y2=\"8\"/></svg></button>",
  "randomgen.t10": "<div class=\"randomgen-popup-backdrop\" id=\"randomTopicPopup\"><div class=\"randomgen-popup randomgen-topic-popup-large\" onclick=\"event.stopPropagation()\"><div class=\"randomgen-topic-popup-tabs\"><button type=\"button\" class=\"randomgen-topic-tab active\" data-tab=\"select\">テーマを選ぶ</button><button type=\"button\" class=\"randomgen-topic-tab\" data-tab=\"add\">テーマを追加</button></div><div class=\"randomgen-topic-tab-panel active\" id=\"randomTopicSelectPanel\" data-tab=\"select\"><div class=\"randomgen-topic-actions\"><button type=\"button\" class=\"btn btn-ghost\" id=\"randomTopicSelectAll\">すべて選択</button><button type=\"button\" class=\"btn btn-ghost\" id=\"randomTopicDeselectAll\">すべて解除</button></div><div id=\"randomTopicList\" class=\"randomgen-topic-grid\">",
  "randomgen.t11": "</div><div id=\"randomTopicOptionsWrap\" class=\"randomgen-topic-options-wrap\"><div class=\"randomgen-popup-title\">選んだテーマ <span class=\"randomgen-topic-hint\">(ピン: 常に1つ含める)</span></div><div id=\"randomTopicSelectedList\" class=\"randomgen-topic-selected-list\"></div></div></div><div class=\"randomgen-topic-tab-panel\" id=\"randomTopicAddPanel\" data-tab=\"add\"><div class=\"randomgen-add-section\"><div class=\"randomgen-add-header\"><h3 class=\"randomgen-add-title\">新しいテーマを追加</h3><p class=\"randomgen-add-desc\">項目をカンマ区切りで入力してください。</p></div><div id=\"randomTopicAddForm\" class=\"randomgen-add-form\"><div class=\"randomgen-add-row\"><div class=\"randomgen-add-field\"><label class=\"randomgen-add-label\">名前</label><input type=\"text\" id=\"addTopicLabel\" placeholder=\"わたしのテーマ\" class=\"field-input\"></div><div class=\"randomgen-add-field\"><label class=\"randomgen-add-label\">グループ</label><input type=\"text\" id=\"addTopicGroup\" placeholder=\"その他\" class=\"field-input\" value=\"その他\"></div></div><div class=\"randomgen-add-field randomgen-add-field-id\"><label class=\"randomgen-add-label\">ID <span class=\"randomgen-add-hint\">(空なら名前から自動生成)</span></label><input type=\"text\" id=\"addTopicId\" placeholder=\"my_topic\" class=\"field-input\"></div><div class=\"randomgen-add-field\"><label class=\"randomgen-add-label\">項目</label><textarea id=\"addTopicItems\" class=\"field-input\" rows=\"4\" placeholder=\"項目1, 項目2, 項目3\"></textarea></div><div class=\"randomgen-add-actions\"><button class=\"btn btn-primary\" id=\"addTopicBtn\">追加</button><span id=\"addTopicMsg\" class=\"randomgen-add-msg\"></span></div></div></div></div><button type=\"button\" class=\"randomgen-topic-close-fab\" id=\"randomTopicClose\" title=\"閉じる\">×</button></div></div>",
  "randomgen.t12": "<div class=\"randomgen-popup-backdrop\" id=\"randomTablePopup\"><div class=\"randomgen-popup randomgen-table-popup\" onclick=\"event.stopPropagation()\"><div class=\"randomgen-popup-title\" id=\"randomTableTitle\">項目</div><div id=\"randomTableContent\" class=\"randomgen-table-content\"></div><button type=\"button\" class=\"btn btn-ghost\" style=\"margin-top:12px;\" id=\"randomTableClose\">閉じる</button></div></div>",
  "randomgen.t13": "<div class=\"randomgen-popup-backdrop\" id=\"randomInfoPopup\"><div class=\"randomgen-popup\" onclick=\"event.stopPropagation()\"><div class=\"randomgen-popup-title\">出典</div><div class=\"randomgen-info-content\"><p>テーマ・キーワードの参考:</p><p><a href=\"https://nihilapp.github.io/keyword\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--accent);\">ニヒル ランダムキーワード</a> · <a href=\"https://github.com/nihilapp/random-keyword-code\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--accent);\">GitHub</a></p></div><button type=\"button\" class=\"btn btn-ghost\" style=\"margin-top:12px;\" id=\"randomInfoClose\">閉じる</button></div></div>",
