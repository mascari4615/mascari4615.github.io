{
  "name": "karmolab-js",
  "private": true,
  "version": "1.0.0",
  "description": "KarmoLab TypeScript sources; build emits to js/ for Jekyll/GitHub Pages",
  "type": "module",
  "dependencies": {
    "karmolab-ai": "file:../../packages/karmolab-ai",
    "qrcode-generator": "^1.4.4"
  },
  "scripts": {
    "build:wiki": "node scripts/sync-wiki.mjs",
    "build": "npm run typecheck && npm run build:wiki && node build.mjs && npm run test:tools && npm run test:bundles && npm run test:gif && npm run test:video && npm run test:trim",
    "test:bundles": "node scripts/check-bundles.mjs",
    "test:gif": "node scripts/test-gif.mjs",
    "test:video": "node scripts/test-video2gif.mjs",
    "test:trim": "node scripts/test-videotrim.mjs",
    "test:tools": "node scripts/smoke-tools.mjs",
    "gen:tool-pages": "node scripts/gen-tool-pages.mjs",
    "typecheck": "tsc --noEmit",
    "test:contrast": "node scripts/smoke-contrast.mjs",
    "test:live": "node scripts/smoke-live-pages.mjs",
    "gen:og": "node scripts/gen-og-images.mjs",
    "test:behavior": "node scripts/smoke-tool-behavior.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "typescript": "~5.9.0"
  }
}
