          "text": "volatile bool tick = false;   // volatile 필수 (최적화로 안 사라지게)\n\nvoid ISR_timer() {            // 인터럽트 핸들러\n  tick = true;               // 플래그만 세우고 즉시 리턴\n}                            // delay, Serial, malloc, 긴 계산 금지\n\nvoid loop() {\n  if (tick) { tick = false; doHeavyWork(); }  // 처리는 메인에서\n}"
