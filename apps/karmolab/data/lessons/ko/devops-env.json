          "label": "설정 한 파일에 모으기",
          "text": "// config.js. 앱에서 process.env 를 보는 유일한 파일\nimport { z } from 'zod';\n\nconst schema = z.object({\n  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),\n  PORT: z.coerce.number().int().positive().default(3000),\n  DATABASE_URL: z.string().url(),                 // 필수, 형식까지\n  LOG_LEVEL: z.enum(['debug', 'info', 'warn', 'error']).default('info'),\n  STRIPE_SECRET_KEY: z.string().startsWith('sk_'),\n});\n\nconst parsed = schema.safeParse(process.env);\nif (!parsed.success) {\n  console.error('설정 오류:\\n' + parsed.error.issues.map((i) => `  ${i.path}: ${i.message}`).join('\\n'));\n  process.exit(1);                                 // 시작하지 않는다\n}\nexport const config = parsed.data;                 // 타입이 붙은 값"
