e { margin:8px 0 0; font:12px/1.65 ui-monospace, monospace; color:#cbd5e1; white-space:pre-wrap; }\n  .hint { font-size:12px; color:#94a3b8; margin-top:6px; }\n  .ok { color:#4ade80; } .no { color:#fca5a5; } .warn { color:#fbbf24; } .dim { color:#64748b; }\n</style>\n<div class=\"wrap\">\n  <div class=\"cmd\" id=\"cmd\"></div>\n  <div id=\"viz\"></div>\n  <pre id=\"app\"></pre>\n  <div class=\"hint\" id=\"hint\"></div>\n</div>\n<script>\n  const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');\n  const box = (title, body, cls) =>\n    '<div class=\"box ' + (cls || '') + '\"><h5>' + esc(title) + '</h5>' + esc(body) + '</div>';\n  const steps = (rows) => '<div class=\"steps\">' + rows.map(([txt, cls]) =>\n    '<div class=\"s ' + (cls || '') + '\">' + esc(txt) + '</div>').join('') + '</div>';\n  const cmp = (aTitle, aBody, bTitle, bBody, aCls, bCls) =>\n    '<div class=\"cmp\"><div class=\"col ' + (aCls||'') + '\"><h6>' + esc(aTitle) + '</h6><pre>' + esc(aBody) + '</pre></div>' +\n    '<div class=\"col b ' + (bCls||'') + '\"><h6>' + esc(bTitle) + '</h6><pre>' + esc(bBody) + '</pre></div></div>';\n  function bars(rows) { return '<div class=\"bars\">' + rows.map((r) =>\n    '<div class=\"row\"><span class=\"lab\">' + esc(r.lab) + '</span><span class=\"track\">' +\n    '<span class=\"fill ' + (r.cls||'') + '\" style=\"width:' + Math.max(0, Math.min(100, r.pct)) + '%\"></span></span>' +\n    '<span class=\"val\">' + esc(r.val) + '</span></div>').join('') + '</div>'; }\n  function render(cmd, body, hint, viz) {\n    document.getElementById('cmd').textContent = cmd || '';\n    document.getElementById('viz').innerHTML = viz || '';\n    document.getElementById('app').innerHTML = body;\n    document.getElementById('hint').textContent = hint || '';\n  }\n</script>\n<script>\n  const m = '{{method}}';\n  const table = {\n    'concierge': ['콘시어지', '제품 없이 손으로 대신 해 줌 → 사람들이 진짜 원하는지·과정을 배움', '몇 시간~며칠'],\n    'waitlist': ['대기자·사전예약', '관심을 행동(등록·결제)으로 확인 → 말이 아닌 수요', '며칠'],\n    'landing': ['한 장 소개 페이지', '가입·클릭률로 수요 측정 → 만들기 전에 반응', '며칠'],\n    'fake': ['남의 도구로 흉내', '기존 도구 조합으로 먼저 굴려 봄 → 코드 0', '며칠'],\n    'build': ['그냥 만들기(비쌈)', '몇 달 만들고 나서야 진짜인지 앎 → 틀리면 큰 손실', '몇 달'],\n  };\n  const r = table[m];\n  const cheap = m !== 'build';\n  render('검증 방법: ' + r[0] + '  (' + r[2] + ')',\n    box(r[0], r[1], cheap ? 'good' : 'bad') + '  ' +\n    (cheap ? '<span class=\"ok\">코드 한 줄 전에 며칠·몇 시간으로 「진짜인가」를 배운다.</span>' : '<span class=\"no\">몇 달 만들고서야 앎 — 틀리면 가장 비싼 방법.</span>'),\n    '만들기 전에 가장 싸게 검증 — 콘시어지·대기자·랜딩·흉내.',\n    bars([{ lab: '비용/시간', pct: cheap ? 20 : 95, val: r[2], cls: cheap ? 'g' : 'b' }, { lab: '배움 속도', pct: cheap ? 90 : 25, val: cheap ? '빠름' : '느림', cls: cheap ? 'g' : 'b' }]));\n</script>",
