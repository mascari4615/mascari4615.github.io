const c = '{{case}}';\n  const t = {\n    into: ['cp -r src dst', ['dst 가 있으면  ->  dst/src/  (안으로 들어간다)',\n      'dst 가 없으면  ->  dst/       (src 의 내용이 dst 가 된다)'],\n      '같은 명령이 대상 존재 여부에 따라 다르게 동작한다 — 이것 때문에 두 번 실행하면 중첩된다.'],\n    slash: ['rsync -a src/ dst/  vs  rsync -a src dst/',\n      ['src/ (슬래시 있음)  ->  dst/ 안에 src 의 내용',\n       'src  (슬래시 없음)  ->  dst/src/ 로 폴더째'],\n      'rsync 의 뒤 슬래시는 「내용만」이라는 뜻이다. 백업 스크립트가 이상해지는 1순위.'],\n    over: ['mv a.txt b.txt', ['b.txt 가 이미 있어도 묻지 않고 덮어쓴다'],\n      'mv -i 로 묻게 하거나, mv -n 으로 있으면 건너뛰게 한다. 백업은 mv -b.'],\n    rm:   ['rm -rf build', ['확인 없이 통째로 지운다 · 휴지통이 없다'],\n      '먼저 ls 로 대상을 확인하고, 변수를 쓸 때는 비어 있는지 반드시 막아라.'],\n  }[c];\n  render(t[0], t[1].map((s) => '  ' + esc(s)).join('\\n'), t[2]);\n</script>",
