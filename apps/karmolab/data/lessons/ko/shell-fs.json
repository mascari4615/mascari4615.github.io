const k = '{{kind}}';\n  const t = {\n    hard: ['ln data.txt copy.txt',\n      ['data.txt  ->  inode 4021  (내용)', 'copy.txt  ->  inode 4021  (같은 실체)'],\n      'data.txt 를 지워도 copy.txt 는 멀쩡하다. inode 는 이름이 0개가 될 때 비로소 사라진다.',\n      '같은 디스크 안에서만 가능 · 폴더에는 못 건다'],\n    sym: ['ln -s data.txt link.txt',\n      ['data.txt  ->  inode 4021', 'link.txt  ->  \"data.txt\" 라는 글자를 담은 다른 파일'],\n      'data.txt 를 지우면 link.txt 는 깨진 링크가 된다(가리킬 대상이 없다).',\n      '디스크를 넘어도 되고 폴더도 가리킬 수 있다 — 그래서 실무에서 압도적으로 많이 쓴다'],\n    copy: ['cp data.txt copy.txt',\n      ['data.txt  ->  inode 4021', 'copy.txt  ->  inode 5177  (내용을 베낀 새 실체)'],\n      '완전히 다른 파일이다. 한쪽을 고쳐도 다른 쪽은 그대로.',\n      '용량을 두 배로 쓴다'],\n  }[k];\n  render(t[0], t[1].map((s) => '  ' + esc(s)).join('\\n') + '\\n\\n  ' + esc(t[2]), t[3]);\n</script>",
