const c = '{{case}}';\n  const t = {\n    order: ['echo $PATH',\n      ['/home/mas/.nvm/versions/node/v22/bin  <- 여기가 먼저',\n       '/usr/local/bin', '/usr/bin', '/bin'],\n      '앞에 있는 폴더가 이긴다. nvm·pyenv 가 PATH 앞에 자기 폴더를 끼워 넣는 방식으로 버전을 바꾼다.'],\n    which: ['which -a node',\n      ['/home/mas/.nvm/versions/node/v22/bin/node   <- 실제로 실행되는 것',\n       '/usr/bin/node                               <- 가려져 있는 것'],\n      '-a 는 전부 보여 준다. 버전이 이상하면 이 목록의 순서를 의심하라.'],\n    type:  ['type -a ls',\n      ['ls is aliased to `ls --color=auto`', 'ls is /usr/bin/ls'],\n      'which 는 파일만 본다. 별칭·함수·내장 명령까지 보려면 type 이다.'],\n    hash:  ['hash -r',\n      ['셸이 기억해 둔 명령 위치를 지운다'],\n      '새로 설치했는데 옛 경로가 계속 실행되면 이것 한 줄로 풀린다.'],\n  }[c];\n  render(t[0], t[1].map((s) => '  ' + esc(s)).join('\\n'), t[2]);\n</script>",
