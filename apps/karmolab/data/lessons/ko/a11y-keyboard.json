          "height": "420px",
          "text": "<style>\n  body { font: 13px/1.7 system-ui, sans-serif; margin:0; color:#e2e8f0; }\n  .wrap { background:#0b1220; border-radius:10px; padding:12px; }\n  .cmd { font:12.5px/1.7 ui-monospace, monospace; color:#7dd3fc; white-space:pre-wrap; }\n  .box { background:#111c33; border-radius:8px; padding:8px 10px; margin:6px 0;\n         font:12px/1.7 ui-monospace, monospace; white-space:pre-wrap; }\n  .box.bad { background:#2a1414; border:1px solid #7f1d1d; }\n  .box.good { background:#132a1c; border:1px solid #166534; }\n  .box h5 { margin:0 0 4px; font:11px system-ui; color:#94a3b8; font-weight:600; }\n  .flow { display:flex; gap:6px; flex-wrap:wrap; align-items:center; margin:8px 0; }\n  .flow .n { padding:6px 10px; border-radius:6px; background:#111c33; border:1px solid #334155; font:12px ui-monospace, monospace; }\n  .flow .n.focus { background:#0e2a3a; border-color:#22d3ee; color:#e2f5ff; box-shadow:0 0 0 2px #22d3ee55; }\n  .flow .n.skip { opacity:.35; text-decoration:line-through; }\n  .flow .n.ring { outline:2px solid #4ade80; outline-offset:2px; }\n  .flow .arrow { color:#475569; }\n  .cmp { display:flex; gap:8px; margin:8px 0; }\n  .cmp .col { flex:1; background:#111c33; border-radius:6px; padding:8px; }\n  .cmp .col h6 { margin:0 0 4px; font:11px system-ui; color:#7dd3fc; } .cmp .col.b h6 { color:#c4b5fd; }\n  .cmp pre { margin:0; font:10.5px/1.5 ui-monospace, monospace; color:#cbd5e1; white-space:pre-wrap; }\n  .cmp .col.good { border:1px solid #166534; } .cmp .col.bad { border:1px solid #7f1d1d; }\n  .steps { margin:8px 0; }\n  .steps .s { padding:5px 9px; margin:3px 0; border-radius:5px; background:#111c33; border-left:3px solid #334155;\n              font:11.5px/1.5 ui-monospace, monospace; }\n  .steps .s.on { background:#0e2a3a; border-left-color:#22d3ee; color:#e2f5ff; }\n  .steps .s.good { border-left-color:#22c55e; background:#132a1c; } .steps .s.bad { border-left-color:#ef4444; background:#2a1414; }\n  pre { margin:8px 0 0; font:12px/1.65 ui-monospace, monospace; color:#cbd5e1; white-space:pre-wrap; }\n  .hint { font-size:12px; color:#94a3b8; margin-top:6px; }\n  .ok { color:#4ade80; } .no { color:#fca5a5; } .warn { color:#fbbf24; } .dim { color:#64748b; }\n</style>\n<div class=\"wrap\">\n  <div class=\"cmd\" id=\"cmd\"></div>\n  <div id=\"viz\"></div>\n  <pre id=\"app\"></pre>\n  <div class=\"hint\" id=\"hint\"></div>\n</div>\n<script>\n  const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');\n  const box = (title, body, cls) =>\n    '<div class=\"box ' + (cls || '') + '\"><h5>' + esc(title) + '</h5>' + esc(body) + '</div>';\n  const steps = (rows) => '<div class=\"steps\">' + rows.map(([txt, cls]) =>\n    '<div class=\"s ' + (cls || '') + '\">' + esc(txt) + '</div>').join('') + '</div>';\n  const cmp = (aTitle, aBody, bTitle, bBody, aCls, bCls) =>\n    '<div class=\"cmp\"><div class=\"col ' + (aCls||'') + '\"><h6>' + esc(aTitle) + '</h6><pre>' + esc(aBody) + '</pre></div>' +\n    '<div class=\"col b ' + (bCls||'') + '\"><h6>' + esc(bTitle) + '</h6><pre>' + esc(bBody) + '</pre></div></div>';\n  function flow(nodes) { return '<div class=\"flow\">' + nodes.map((nd, i) =>\n    (i ? '<span class=\"arrow\">-&gt;</span>' : '') +\n    '<span class=\"n ' + (nd.cls || '') + '\">' + esc(nd.label) + '</span>').join('') + '</div>'; }\n  function render(cmd, body, hint, viz) {\n    document.getElementById('cmd').textContent = cmd || '';\n    document.getElementById('viz').innerHTML = viz || '';\n    document.getElementById('app').innerHTML = body;\n    document.getElementById('hint').textContent = hint || '';\n  }\n</script>\n<script>\n  const show = '{{show}}' !== 'none';\n  const pos = {{pos}};\n  const labels = ['홈', '검색', '장바구니', '로그인'];\n  const nodes = labels.map((lb, i) => ({ label: lb, cls: i === pos ? (show ? 'ring' : 'focus-none') : '' }));\n  if (!show) nodes.forEach((n, i) => { if (i === pos) n.cls = ''; });\n  render(show ? ':focus-visible 링 있음. 위치가 보임' : 'outline:none. 위치를 잃음',\n    (show ? '<span class=\"ok\">포커스 링(초록 테두리)이 지금 어디인지 알려 준다.</span>'\n          : '<span class=\"no\">포커스 링이 없어 Tab 을 눌러도 어디 있는지 안 보인다. 조작 불가.</span>') +\n    '\\n  지금 포커스(내부): ' + labels[pos] + (show ? '  (초록 링으로 표시됨)' : '  (화면엔 표시 안 됨)'),\n    'outline:none 으로 지우지 말고 :focus-visible 로 또렷한 링을. 대비 3:1.',\n    flow(nodes));\n</script>",
          "controls": [
