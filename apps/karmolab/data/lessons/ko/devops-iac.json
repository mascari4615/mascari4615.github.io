          "text": "<style>\n  body { font: 13px/1.7 system-ui, sans-serif; margin:0; color:#e2e8f0; }\n  .wrap { background:#0b1220; border-radius:10px; padding:12px; }\n  .cmd { font:12.5px/1.7 ui-monospace, monospace; color:#7dd3fc; white-space:pre-wrap; }\n  .cols { display:flex; gap:8px; margin:8px 0; }\n  .col { flex:1; background:#111c33; border-radius:8px; padding:8px 10px; }\n  .col h4 { margin:0 0 6px; font-size:11px; color:#94a3b8; font-weight:600; }\n  .col .it { font:11.5px/1.9 ui-monospace, monospace; color:#cbd5e1; }\n  .col .it.add { color:#4ade80; } .col .it.del { color:#fca5a5; }\n  .col .it.chg { color:#fbbf24; } .col .it.dim { color:#475569; }\n  pre { margin:8px 0 0; font:12px/1.65 ui-monospace, monospace; color:#cbd5e1; white-space:pre-wrap; }\n  .hint { font-size:12px; color:#94a3b8; margin-top:6px; }\n  .ok { color:#4ade80; } .no { color:#fca5a5; } .warn { color:#fbbf24; } .dim { color:#64748b; }\n</style>\n<div class=\"wrap\">\n  <div class=\"cmd\" id=\"cmd\"></div>\n  <div id=\"viz\"></div>\n  <pre id=\"app\"></pre>\n  <div class=\"hint\" id=\"hint\"></div>\n</div>\n<script>\n  const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');\n  const cols = (list) => '<div class=\"cols\">' + list.map(([title, items]) =>\n    '<div class=\"col\"><h4>' + esc(title) + '</h4>' +\n    items.map(([t, cls]) => '<div class=\"it ' + (cls || '') + '\">' + esc(t) + '</div>').join('') +\n    '</div>').join('') + '</div>';\n  function render(cmd, body, hint, viz) {\n    document.getElementById('cmd').textContent = cmd || '';\n    document.getElementById('viz').innerHTML = viz || '';\n    document.getElementById('app').innerHTML = body;\n    document.getElementById('hint').textContent = hint || '';\n  }\n</script>\n<script>\n  const c = '{{kind}}';\n  const t = {\n    create: ['+ create', 'add', '새로 만든다', ['안전하다 — 기존 것은 안 건드린다', '비용은 는다'],\n      '개수를 확인하라. 의도보다 많으면 for_each·count 를 잘못 쓴 것.'],\n    update: ['~ update in-place', 'chg', '그 자리에서 고친다', ['자원은 유지되고 속성만 바뀐다', '대개 안전'],\n      '다만 어떤 속성은 중단을 유발한다 — 로드밸런서 리스너·보안 그룹은 순간 끊길 수 있다.'],\n    replace:['-/+ destroy and then create', 'del', '<span class=\"no\">지우고 다시 만든다</span>',\n      ['DB·볼륨이면 자료가 사라진다', 'IP·엔드포인트가 바뀐다'],\n      '<span class=\"warn\">plan 에서 이 표시를 보면 멈춰라.</span> 왜 재생성인지(force replacement 사유) 반드시 읽어라.'],\n    destroy:['- destroy', 'del', '지운다', ['코드에서 리소스를 뺐거나 조건이 꺼졌다'],\n      '의도한 삭제인지 확인. prevent_destroy 로 중요한 자원은 아예 못 지우게 막을 수 있다.'],\n    known:  ['(known after apply)', 'dim', '지금은 알 수 없는 값', ['ID·ARN 처럼 만들어야 정해지는 값'],\n      '정상이다. 다만 이 값에 의존하는 것들도 함께 「알 수 없음」이 되어 diff 가 커 보인다.'],\n  }[c];\n  const items = [['+ aws_s3_bucket.logs', c === 'create' ? 'add' : 'dim'],\n                 ['~ aws_instance.web (tags)', c === 'update' ? 'chg' : 'dim'],\n                 ['-/+ aws_db_instance.main', c === 'replace' ? 'del' : 'dim'],\n                 ['- aws_security_group.old', c === 'destroy' ? 'del' : 'dim'],\n                 ['id = (known after apply)', c === 'known' ? '' : 'dim']];\n  render('terraform plan',\n    '  <span class=\"' + t[1] + '\">' + esc(t[0]) + '</span>  —  ' + t[2] + '\\n\\n' +\n    t[3].map((s) => '  · ' + esc(s)).join('\\n') + '\\n\\n  ' + t[4],\n    'Plan: 1 to add, 1 to change, 1 to destroy — 이 요약 줄을 늘 소리 내어 읽어라.',\n    cols([['plan 출력', items]]));\n</script>",
