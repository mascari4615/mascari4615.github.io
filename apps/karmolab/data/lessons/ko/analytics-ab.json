          "text": "<style>\n  body { font: 13px/1.7 system-ui, sans-serif; margin:0; color:#e2e8f0; }\n  .wrap { background:#0b1220; border-radius:10px; padding:12px; }\n  .cmd { font:12.5px/1.7 ui-monospace, monospace; color:#7dd3fc; white-space:pre-wrap; }\n  .box { background:#111c33; border-radius:8px; padding:8px 10px; margin:6px 0;\n         font:12px/1.7 ui-monospace, monospace; white-space:pre-wrap; }\n  .box.bad { background:#2a1414; border:1px solid #7f1d1d; }\n  .box.good { background:#132a1c; border:1px solid #166534; }\n  .box h5 { margin:0 0 4px; font:11px system-ui; color:#94a3b8; font-weight:600; }\n  .bars { margin:8px 0; }\n  .bars .row { display:flex; align-items:center; gap:8px; margin:4px 0; font:11px ui-monospace, monospace; }\n  .bars .lab { width:120px; color:#94a3b8; text-align:right; }\n  .bars .track { flex:1; height:16px; background:#111c33; border-radius:4px; overflow:hidden; }\n  .bars .fill { height:100%; } .bars .fill.g { background:#4ade80; } .bars .fill.b { background:#7f1d1d; } .bars .fill.c { background:#22d3ee; } .bars .fill.w { background:#fbbf24; }\n  .bars .val { width:64px; color:#cbd5e1; }\n  .split { display:flex; gap:6px; margin:8px 0; }\n  .split .g { flex:1; border-radius:8px; padding:8px; text-align:center; font:11px ui-monospace, monospace; }\n  .split .g.a { background:#0e2a3a; border:1px solid #22d3ee; } .split .g.b { background:#1a1436; border:1px solid #a78bfa; }\n  .split .g .mix { margin-top:4px; font-size:10px; color:#94a3b8; }\n  .steps { margin:8px 0; }\n  .steps .s { padding:5px 9px; margin:3px 0; border-radius:5px; background:#111c33; border-left:3px solid #334155;\n              font:11.5px/1.5 ui-monospace, monospace; }\n  .steps .s.on { background:#0e2a3a; border-left-color:#22d3ee; color:#e2f5ff; }\n  .steps .s.good { border-left-color:#22c55e; background:#132a1c; } .steps .s.bad { border-left-color:#ef4444; background:#2a1414; }\n  pre { margin:8px 0 0; font:12px/1.65 ui-monospace, monospace; color:#cbd5e1; white-space:pre-wrap; }\n  .hint { font-size:12px; color:#94a3b8; margin-top:6px; }\n  .ok { color:#4ade80; } .no { color:#fca5a5; } .warn { color:#fbbf24; } .dim { color:#64748b; }\n</style>\n<div class=\"wrap\">\n  <div class=\"cmd\" id=\"cmd\"></div>\n  <div id=\"viz\"></div>\n  <pre id=\"app\"></pre>\n  <div class=\"hint\" id=\"hint\"></div>\n</div>\n<script>\n  const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');\n  const box = (title, body, cls) =>\n    '<div class=\"box ' + (cls || '') + '\"><h5>' + esc(title) + '</h5>' + esc(body) + '</div>';\n  const steps = (rows) => '<div class=\"steps\">' + rows.map(([txt, cls]) =>\n    '<div class=\"s ' + (cls || '') + '\">' + esc(txt) + '</div>').join('') + '</div>';\n  function bars(rows) { return '<div class=\"bars\">' + rows.map((r) =>\n    '<div class=\"row\"><span class=\"lab\">' + esc(r.lab) + '</span><span class=\"track\">' +\n    '<span class=\"fill ' + (r.cls||'') + '\" style=\"width:' + Math.max(0, Math.min(100, r.pct)) + '%\"></span></span>' +\n    '<span class=\"val\">' + esc(r.val) + '</span></div>').join('') + '</div>'; }\n  function split(aTop, aMix, bTop, bMix) {\n    return '<div class=\"split\"><div class=\"g a\">' + esc(aTop) + '<div class=\"mix\">' + esc(aMix) + '</div></div>' +\n      '<div class=\"g b\">' + esc(bTop) + '<div class=\"mix\">' + esc(bMix) + '</div></div></div>'; }\n  function render(cmd, body, hint, viz) {\n    document.getElementById('cmd').textContent = cmd || '';\n    document.getElementById('viz').innerHTML = viz || '';\n    document.getElementById('app').innerHTML = body;\n    document.getElementById('hint').textContent = hint || '';\n  }\n</script>\n<script>\n  const peeks = {{peeks}};\n  const fpr = Math.round((1 - Math.pow(0.95, peeks)) * 100);\n  render((peeks === 1 ? '한 번만 판단(정상)' : peeks + '번 훔쳐보며 유의 순간 멈춤') + '  →  거짓 양성률 약 ' + fpr + '%',\n    steps([\n      ['한 번 볼 때 우연 유의 확률: 5% (p<0.05)', ''],\n      [peeks + '번 반복 관찰 후 「유의하면 멈춤」 → 거짓 양성률 ' + fpr + '%', peeks === 1 ? 'good' : peeks <= 5 ? 'on' : 'bad'],\n    ]) + '  ' + (peeks === 1\n      ? '<span class=\"ok\">미리 정한 시점에 한 번 판단 — 5% 유지.</span>'\n      : '<span class=\"no\">훔쳐볼수록 우연 유의를 낚아채 거짓 양성이 치솟는다 — 효과가 없어도 멈추게 됨.</span>'),\n    '미리 정한 표본을 채운 뒤 판단 · 중간에 보려면 순차 검정을 설계.',\n    bars([{ lab: '거짓 양성률', pct: fpr * 2.5, val: fpr + '%', cls: peeks === 1 ? 'g' : peeks <= 5 ? 'w' : 'b' }]));\n</script>",
