th    ' + points.length + '   (코드포인트 수)\\n'\n     + 'UTF-8 바이트 수  ' + bytes.length + '\\n'\n     + '코드포인트       ' + points.map((c) => 'U+' + c.codePointAt(0).toString(16).toUpperCase()).join(' ') + '\\n'\n     + 'UTF-8 바이트     ' + [...bytes].map((b) => b.toString(16).padStart(2, '0')).join(' ') + '\\n\\n'\n     + 's.slice(0, 1)  -> \"' + s.slice(0, 1) + '\"   <- 여기서 글자가 깨지면 그게 이 장의 요점이다.');\n</script>",
