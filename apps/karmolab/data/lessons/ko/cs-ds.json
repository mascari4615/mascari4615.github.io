              "label": "칸 수",
              "type": "range",
              "min": 4,
              "max": 64,
              "step": 4,
              "value": 16
            },
            {
              "id": "keys",
              "label": "키 수",
              "type": "range",
              "min": 4,
              "max": 80,
              "step": 4,
              "value": 20
            }
