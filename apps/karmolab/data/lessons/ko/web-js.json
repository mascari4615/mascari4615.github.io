        {
          "type": "demo",
          "kind": "html",
          "label": "한 줄로 기다리기 vs 한꺼번에 — 시간을 재 보라",
          "height": "260px",
          "text": "<style>\n  body { font: 13.5px/1.7 ui-monospace, SFMono-Regular, Menlo, monospace; margin: 0; }\n  pre { margin: 0; padding: 12px; background: #0b1220; color: #e2e8f0; border-radius: 10px; white-space: pre-wrap; }\n  .k { color: #7dd3fc; } .v { color: #fde68a; } .x { color: #fca5a5; } .o { color: #86efac; }\n</style>\n<pre id=\"out\"></pre>\n<script>\n  const lines = [];\n  const log = (...a) => lines.push(a.map((v) => typeof v === 'string' ? v : JSON.stringify(v)).join(' '));\n  const flush = () => { document.getElementById('out').textContent = lines.join('\\n'); };\n  const mode = '{{mode}}';\n  const N = {{n}};\n  const wait = (ms) => new Promise((r) => setTimeout(r, ms));\n  const fake = (i) => wait(200).then(() => i);\n\n  (async () => {\n    const t0 = performance.now();\n    let got;\n    if (mode === 'serial') {\n      got = [];\n      for (let i = 0; i < N; i++) got.push(await fake(i));   // 하나 끝나야 다음\n    } else {\n      got = await Promise.all(Array.from({ length: N }, (_, i) => fake(i)));\n    }\n    const ms = Math.round(performance.now() - t0);\n    log(mode === 'serial' ? 'for 안에서 await (한 줄로 기다림)' : 'Promise.all (한꺼번에 보냄)');\n    log('요청 ' + N + '개 · 각 200ms');\n    log('걸린 시간: ' + ms + 'ms');\n    log('');\n    log(mode === 'serial' ? '-> 200ms x ' + N + ' 만큼 쌓인다' : '-> 가장 느린 하나만큼(약 200ms)');\n    flush();\n  })();\n  flush();\n</script>",
