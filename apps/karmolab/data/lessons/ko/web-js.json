          "text": "<style>\n  body { font: 13.5px/1.7 ui-monospace, SFMono-Regular, Menlo, monospace; margin: 0; }\n  pre { margin: 0; padding: 12px; background: #0b1220; color: #e2e8f0; border-radius: 10px; white-space: pre-wrap; }\n  .k { color: #7dd3fc; } .v { color: #fde68a; } .x { color: #fca5a5; } .o { color: #86efac; }\n</style>\n<pre id=\"out\"></pre>\n<script>\n  const lines = [];\n  const log = (...a) => lines.push(a.map((v) => typeof v === 'string' ? v : JSON.stringify(v)).join(' '));\n  const flush = () => { document.getElementById('out').textContent = lines.join('\\n'); };\n  const kind = '{{kind}}';\n  const fail = () => { throw new Error('터졌다'); };\n\n  if (kind === 'sync') {\n    try { fail(); } catch (e) { log('잡혔다:', e.message); }\n    log('-> 동기 코드는 try/catch 로 잡힌다');\n  } else if (kind === 'timer') {\n    try { setTimeout(fail, 0); } catch (e) { log('잡혔다:', e.message); }\n    log('setTimeout 안의 오류는 이 try/catch 를 지나간다');\n    log('-> 콜백은 나중에, 다른 자리에서 돈다. 콜백 안에서 try 하라');\n    window.addEventListener('error', () => { log('전역 error 로만 알 수 있다'); flush(); });\n  } else if (kind === 'promise') {\n    try { Promise.reject(new Error('거부')); } catch (e) { log('잡혔다'); }\n    log('await 없는 프라미스 거부도 지나간다 (unhandledrejection)');\n    window.addEventListener('unhandledrejection', (e) => { log('-> unhandledrejection:', e.reason.message); e.preventDefault(); flush(); });\n  } else {\n    (async () => {\n      try { await Promise.reject(new Error('거부')); }\n      catch (e) { log('await + try/catch 로 잡혔다:', e.message); flush(); }\n    })();\n    log('-> 프라미스는 await 해야 try/catch 안으로 들어온다');\n  }\n  flush();\n</script>",
