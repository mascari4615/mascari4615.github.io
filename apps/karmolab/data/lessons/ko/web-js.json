          "height": "280px",
          "text": "<style>\n  body { font: 13.5px/1.7 ui-monospace, SFMono-Regular, Menlo, monospace; margin: 0; }\n  pre { margin: 0; padding: 12px; background: #0b1220; color: #e2e8f0; border-radius: 10px; white-space: pre-wrap; }\n  .k { color: #7dd3fc; } .v { color: #fde68a; } .x { color: #fca5a5; } .o { color: #86efac; }\n</style>\n<pre id=\"out\"></pre>\n<script>\n  const lines = [];\n  const log = (...a) => lines.push(a.map((v) => typeof v === 'string' ? v : JSON.stringify(v)).join(' '));\n  const flush = () => { document.getElementById('out').textContent = lines.join('\\n'); };\n  const cases = [\n    ['const o={n:1}; const p=o; p.n=2; o.n', (() => { const o = { n: 1 }; const p = o; p.n = 2; return o.n; })(), 2],\n    ['0 ?? 5', 0 ?? 5, 0],\n    ['0 || 5', 0 || 5, 5],\n    ['Boolean([])', Boolean([]), true],\n    ['[3,1,2].toSorted()[0] (원본 보존)', [3, 1, 2].toSorted ? [3, 1, 2].toSorted()[0] : [...[3, 1, 2]].sort()[0], 1],\n    ['[1,2].findIndex(x=>x===1)', [1, 2].findIndex((x) => x === 1), 0],\n    ['typeof (async()=>{})()', typeof (async () => {})().then, 'function'],\n    ['NaN === NaN', NaN === NaN, false],\n  ];\n  let ok = 0;\n  for (const [label, got, want] of cases) {\n    const pass = JSON.stringify(got) === JSON.stringify(want);\n    if (pass) ok++;\n    log((pass ? '  O  ' : '  X  ') + label + '  ->  ' + JSON.stringify(got));\n  }\n  log('');\n  log('맞은 것 ' + ok + '/' + cases.length + ' — 값이 예상과 다른 줄이 있으면 그 장으로 돌아가라');\n  flush();\n</script>"
