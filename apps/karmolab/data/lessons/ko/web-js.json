        {
          "type": "demo",
          "kind": "html",
          "label": "연산을 골라 보라 — 같은 자료가 어떻게 변하나",
          "height": "300px",
          "text": "<style>\n  body { font: 13.5px/1.7 ui-monospace, SFMono-Regular, Menlo, monospace; margin: 0; }\n  pre { margin: 0; padding: 12px; background: #0b1220; color: #e2e8f0; border-radius: 10px; white-space: pre-wrap; }\n  .k { color: #7dd3fc; } .v { color: #fde68a; } .x { color: #fca5a5; } .o { color: #86efac; }\n</style>\n<pre id=\"out\"></pre>\n<script>\n  const lines = [];\n  const log = (...a) => lines.push(a.map((v) => typeof v === 'string' ? v : JSON.stringify(v)).join(' '));\n  const flush = () => { document.getElementById('out').textContent = lines.join('\\n'); };\n  const op = '{{op}}';\n  const items = [\n    { name: '사료', price: 32000, cat: '먹이', qty: 2 },\n    { name: '모래', price: 12000, cat: '화장실', qty: 3 },\n    { name: '간식', price: 4000, cat: '먹이', qty: 5 },\n  ];\n  log('원본:');\n  items.forEach((i) => log('  ' + i.name + ' ' + i.price + '원 x' + i.qty + ' (' + i.cat + ')'));\n  log('');\n\n  if (op === 'filter') {\n    log(\"filter(i => i.cat === '먹이')\");\n    log('  ->', items.filter((i) => i.cat === '먹이').map((i) => i.name).join(', '));\n  } else if (op === 'map') {\n    log('map(i => ({...i, total: i.price * i.qty}))');\n    items.map((i) => ({ ...i, total: i.price * i.qty })).forEach((i) => log('  ' + i.name + ' -> ' + i.total));\n  } else if (op === 'reduce') {\n    log('reduce((s, i) => s + i.price * i.qty, 0)');\n    log('  ->', items.reduce((s, i) => s + i.price * i.qty, 0) + '원');\n  } else {\n    log('Object.groupBy(items, i => i.cat)  (없으면 reduce 로 같은 일)');\n    const g = items.reduce((acc, i) => { (acc[i.cat] ||= []).push(i.name); return acc; }, {});\n    Object.entries(g).forEach(([k, v]) => log('  ' + k + ': ' + v.join(', ')));\n  }\n  flush();\n</script>",
