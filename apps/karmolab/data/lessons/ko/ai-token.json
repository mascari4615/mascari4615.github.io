const q = [\n    ['같은 뜻이면 한글이 영어보다 토큰이 많다', true],\n    ['문맥창에는 출력만 들어간다', false],\n    ['보통 출력 단가가 입력보다 비싸다', true],\n    ['스트리밍은 총 생성 시간을 줄인다', false],\n    ['max_tokens 는 안 걸어도 안전하다', false],\n    ['작업 난이도에 맞춰 모델을 고르면 비용이 준다', true],\n  ];\n  render('self-check',\n    q.map(([t, a]) => (a ? '<span class=\"ok\">  O  ' : '<span class=\"no\">  X  ') + esc(t) + '</span>').join('\\n'),\n    '틀린 것이 있으면 그 장으로 — 1장(밀도) 2장(창) 3장(비용) 4장(스트리밍) 5장(max) 7장(모델)');\n</script>"
