const c = '{{knob}}';\n  const t = {\n    max:   ['max_tokens (최대 길이)', ['넘으면 그 지점에서 잘린다'],\n      '안전장치로 반드시 설정한다 — 무한 생성·폭주 비용을 막는다.',\n      '<span class=\"warn\">주의: 잘리면 JSON 이 깨진다</span> — 넉넉히 주되 상한은 둔다.'],\n    format:['형식 지정', ['「JSON 만」·「한 문장으로」·스키마 제공'],\n      '가장 효과적. 「설명 없이 결과만」 한 줄이 출력을 절반으로 줄인다.',\n      '구조화 출력(JSON 모드·스키마 강제)을 지원하면 파싱 실패가 사라진다.'],\n    stop:  ['정지 시퀀스', ['특정 문자열이 나오면 멈춘다'],\n      '형식이 끝나는 지점을 알려 준다 — 예: \\'\\\\n\\\\n\\' 나 \\'</answer>\\'.',\n      '반복·군더더기를 자르는 데도 쓴다.'],\n    temp:  ['temperature', ['0 에 가까우면 일관·결정적 · 높으면 다양'],\n      '길이보다 <span class=\"warn\">일관성</span>의 손잡이. 추출·분류는 0, 창작은 높게.',\n      '재현이 필요한 평가·테스트에서는 0(또는 고정 시드).'],\n    schema:['구조화 출력', ['스키마를 주면 그 모양만 나온다'],\n      '「JSON 을 달라」보다 강력하다 — 모델이 형식을 어길 수 없게 강제.',\n      '도구 호출·추출 작업에서 파싱 안정성을 크게 높인다(다음 칸들).'],\n  }[c];\n  render('', '  <span class=\"ok\">' + esc(t[0]) + '</span>\\n\\n' +\n    t[1].map((s) => '  · ' + esc(s)).join('\\n') + '\\n\\n  ' + esc(t[2]) + '\\n  ' + t[3],\n    '통제된 출력 = 예측 가능한 비용·지연·파싱. 셋 다 여기서 좋아진다.');\n</script>",
