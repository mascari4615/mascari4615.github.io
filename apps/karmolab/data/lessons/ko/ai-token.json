const c = '{{q}}';\n  const t = {\n    context:['무엇을 문맥에 넣나', ['전부 넣기 vs 필요한 것만(RAG)', '넣을수록 비싸고 느리고, 가운데를 놓친다'],\n      '기본을 「필요한 것만」으로 — 다음 칸(RAG)의 이유가 여기 있다.'],\n    cache:  ['반복되는 부분이 있나', ['시스템 프롬프트·문서·예시', '캐싱으로 반복 비용 절감'],\n      '자주 쓰는 긴 컨텍스트는 캐시 · 안정적인 접두사를 앞에 둔다.'],\n    stream: ['사람이 읽나 기계가 처리하나', ['읽으면 스트리밍 · 처리하면 완성 후'],\n      'UX 와 파싱이 여기서 갈린다(4장).'],\n    budget: ['비용 상한이 있나', ['사용자별 예산 · 요청별 max_tokens · 알림'],\n      'LLM 은 요청당 비용이 크다 — 상한 없이 열어 두지 마라.'],\n    fallback:['실패하면', ['타임아웃·과부하·창 초과·안전 거부', '재시도 · 대체 모델 · 사용자 안내'],\n      'LLM 호출은 자주 실패한다 — 없으면 서비스가 함께 멈춘다.'],\n  }[c];\n  render('LLM 을 붙일 때',\n    '  <span class=\"ok\">' + esc(t[0]) + '</span>\\n\\n' +\n    t[1].map((s) => '  · ' + esc(s)).join('\\n') + '\\n\\n  ' + esc(t[2]),\n    '토큰 감각이 설계 질문으로 — 문맥·캐시·스트리밍·예산·폴백.');\n</script>",
