          "type": "demo",
          "kind": "html",
          "label": "방식을 골라 보라. 사용자가 무엇을 겪나",
          "height": "340px",
          "text": "<style>\n  body { font: 13px/1.7 system-ui, sans-serif; margin:0; color:#e2e8f0; }\n  .wrap { background:#0b1220; border-radius:10px; padding:12px; }\n  .cmd { font:12.5px/1.7 ui-monospace, monospace; color:#7dd3fc; white-space:pre-wrap; }\n  .toks { display:flex; flex-wrap:wrap; gap:3px; margin:8px 0; }\n  .tok { padding:3px 6px; border-radius:5px; font:12px ui-monospace, monospace; }\n  .bar { height:20px; border-radius:5px; display:flex; overflow:hidden; margin:6px 0; }\n  .bar i { display:block; height:100%; }\n  pre { margin:8px 0 0; font:12px/1.65 ui-monospace, monospace; color:#cbd5e1; white-space:pre-wrap; }\n  .hint { font-size:12px; color:#94a3b8; margin-top:6px; }\n  .ok { color:#4ade80; } .no { color:#fca5a5; } .warn { color:#fbbf24; } .dim { color:#64748b; }\n</style>\n<div class=\"wrap\">\n  <div class=\"cmd\" id=\"cmd\"></div>\n  <div id=\"viz\"></div>\n  <pre id=\"app\"></pre>\n  <div class=\"hint\" id=\"hint\"></div>\n</div>\n<script>\n  const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');\n  const COLORS = ['#1e40af', '#166534', '#854d0e', '#6b21a8', '#9f1239', '#155e75'];\n  /** 대략적 토큰화 — 실제 BPE 는 아니지만 「덩어리로 쪼갠다」를 보여 주는 근사. */\n  function toks(s) {\n    return s.match(/\\s+|[a-zA-Z]+|[0-9]+|[가-힣]|[^\\sa-zA-Z0-9가-힣]/g) || [];\n  }\n  const tokHtml = (list) => '<div class=\"toks\">' + list.map((t, i) =>\n    '<span class=\"tok\" style=\"background:' + COLORS[i % COLORS.length] + '\">' +\n    esc(t === ' ' ? '␣' : t) + '</span>').join('') + '</div>';\n  const bar = (segs) => '<div class=\"bar\">' + segs.map(([pct, c]) =>\n    '<i style=\"width:' + pct + '%;background:' + c + '\"></i>').join('') + '</div>';\n  function render(cmd, body, hint, viz) {\n    document.getElementById('cmd').textContent = cmd || '';\n    document.getElementById('viz').innerHTML = viz || '';\n    document.getElementById('app').innerHTML = body;\n    document.getElementById('hint').textContent = hint || '';\n  }\n</script>\n<script>\n  const c = '{{mode}}';\n  const outTok = 400, tps = 50;  /* 초당 50토큰 생성 가정 */\n  const total = outTok / tps;\n  const t = {\n    wait:   ['전부 기다렸다 한 번에', '첫 글자까지: ' + total.toFixed(1) + '초',\n      '짧은 답은 괜찮지만, 긴 답은 <span class=\"no\">멈춘 것처럼</span> 보인다.'],\n    stream: ['스트리밍 (토큰마다)', '첫 글자까지: 약 0.3초 (TTFT)',\n      '<span class=\"ok\">바로 읽기 시작</span>한다 — 총 시간은 같지만 체감이 다르다.'],\n    ttft:   ['지연의 두 부분', '첫 토큰까지(TTFT) + 토큰당 시간(TPOT)',\n      'TTFT 는 입력 길이·모델 크기에 · TPOT 는 출력 길이에 좌우된다.'],\n    long:   ['긴 입력의 영향', '입력 8000 토큰 -> TTFT 가 늘어난다',\n      '모델이 입력을 다 읽어야 첫 토큰이 나온다 — 입력이 길면 시작도 늦다.'],\n  }[c];\n  render('출력 ' + outTok + ' 토큰 · 초당 ' + tps + ' 토큰',\n    '  <span class=\"ok\">' + esc(t[0]) + '</span>\\n\\n  ' + esc(t[1]) + '\\n\\n  ' + t[2],\n    '체감 속도의 핵심은 「첫 글자까지의 시간(TTFT)」 — 스트리밍이 이걸 극적으로 줄인다.',\n    bar(c === 'stream' ? [[3, '#166534'], [97, '#334155']]\n                       : [[100, c === 'wait' ? '#334155' : '#1e40af']]) +\n    '<div class=\"hint\">' + (c === 'stream' ? '초록=첫 토큰(빠름) · 나머지는 흐르며 채워진다' : '전부 기다린다') + '</div>');\n</script>",
