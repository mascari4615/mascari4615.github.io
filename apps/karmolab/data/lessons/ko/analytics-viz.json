onospace; }\n  .steps .s.on { background:#0e2a3a; border-left-color:#22d3ee; color:#e2f5ff; }\n  .steps .s.good { border-left-color:#22c55e; background:#132a1c; } .steps .s.bad { border-left-color:#ef4444; background:#2a1414; }\n  pre { margin:8px 0 0; font:12px/1.65 ui-monospace, monospace; color:#cbd5e1; white-space:pre-wrap; }\n  .hint { font-size:12px; color:#94a3b8; margin-top:6px; }\n  .ok { color:#4ade80; } .no { color:#fca5a5; } .warn { color:#fbbf24; } .dim { color:#64748b; }\n</style>\n<div class=\"wrap\">\n  <div class=\"cmd\" id=\"cmd\"></div>\n  <div id=\"viz\"></div>\n  <pre id=\"app\"></pre>\n  <div class=\"hint\" id=\"hint\"></div>\n</div>\n<script>\n  const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');\n  const box = (title, body, cls) =>\n    '<div class=\"box ' + (cls || '') + '\"><h5>' + esc(title) + '</h5>' + esc(body) + '</div>';\n  const steps = (rows) => '<div class=\"steps\">' + rows.map(([txt, cls]) =>\n    '<div class=\"s ' + (cls || '') + '\">' + esc(txt) + '</div>').join('') + '</div>';\n  const cmp = (aTitle, aBody, bTitle, bBody, aCls, bCls) =>\n    '<div class=\"cmp\"><div class=\"col ' + (aCls||'') + '\"><h6>' + esc(aTitle) + '</h6><pre>' + esc(aBody) + '</pre></div>' +\n    '<div class=\"col b ' + (bCls||'') + '\"><h6>' + esc(bTitle) + '</h6><pre>' + esc(bBody) + '</pre></div></div>';\n  function chart(vals, labels, base, hlIndex) {\n    const mx = Math.max.apply(null, vals);\n    return '<div class=\"chart\">' + vals.map((v, i) => {\n      const h = (v - base) / (mx - base) * 100;\n      const cls = hlIndex === i ? 'hl' : '';\n      return '<div class=\"col\"><div class=\"bar ' + cls + '\" style=\"height:' + Math.max(1, h) + '%\"></div>' +\n        '<div class=\"cl\">' + esc(labels[i]) + '<br>' + v + '</div></div>';\n    }).join('') + '<div class=\"base\"></div></div>';\n  }\n  function render(cmd, body, hint, viz) {\n    document.getElementById('cmd').textContent = cmd || '';\n    document.getElementById('viz').innerHTML = viz || '';\n    document.getElementById('app').innerHTML = body;\n    document.getElementById('hint').textContent = hint || '';\n  }\n</script>\n<script>\n  const q = '{{q}}';\n  const table = {\n    'compare': ['제품별 매출을 비교', '막대 (0에서 시작)', '원그래프(조각 비교 어려움)·선(비교 아님)'],\n    'trend': ['월별 가입자 변화', '선 그래프', '막대(개수 많으면 답답)·원(변화 표현 X)'],\n    'dist': ['응답 시간이 어떻게 퍼져 있나', '히스토그램 · 박스플롯', '막대(평균 하나)·선(분포 아님)'],\n    'relation': ['광고비와 매출의 관계', '산점도', '막대(관계 표현 X)·원(무관)'],\n    'part': ['채널별 유입 비율(대략)', '누적 막대(또는 조각 적은 원)', '조각 많은 원그래프(비교 어려움)'],\n  };\n  const r = table[q];\n  render('질문: ' + r[0],\n    steps([['맞는 차트: ' + r[1], 'good'], ['피할 것: ' + r[2], 'bad']]) +\n    '  <span class=\"ok\">질문이 형태를 정한다 — 그림은 질문에 맞춰 고른다.</span>',\n    '비교=막대 · 변화=선 · 분포=히스토그램 · 관계=산점도.');\n</script>",
