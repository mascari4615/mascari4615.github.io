          "label": "취약점을 테스트로 박는다",
          "text": "// IDOR 회귀 테스트\ntest('다른 사용자의 주문에 접근하면 404', async () => {\n  const res = await request(app)\n    .get('/api/orders/' + otherUsersOrderId)\n    .set('Cookie', myCookie);\n  expect(res.status).toBe(404);\n});\n\n// 주입 회귀 테스트\ntest('따옴표가 데이터로 취급된다', async () => {\n  const res = await request(app).get('/search?q=' + encodeURIComponent(\"' OR '1'='1\"));\n  expect(res.status).toBe(200);\n  expect(res.body.results).toHaveLength(0);   // 전체가 아니라 0건\n});"
