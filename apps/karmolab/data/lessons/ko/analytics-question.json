monospace, monospace; color:#cbd5e1; white-space:pre-wrap; }\n  .hint { font-size:12px; color:#94a3b8; margin-top:6px; }\n  .ok { color:#4ade80; } .no { color:#fca5a5; } .warn { color:#fbbf24; } .dim { color:#64748b; }\n</style>\n<div class=\"wrap\">\n  <div class=\"cmd\" id=\"cmd\"></div>\n  <div id=\"viz\"></div>\n  <pre id=\"app\"></pre>\n  <div class=\"hint\" id=\"hint\"></div>\n</div>\n<script>\n  const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');\n  const box = (title, body, cls) =>\n    '<div class=\"box ' + (cls || '') + '\"><h5>' + esc(title) + '</h5>' + esc(body) + '</div>';\n  const steps = (rows) => '<div class=\"steps\">' + rows.map(([txt, cls]) =>\n    '<div class=\"s ' + (cls || '') + '\">' + esc(txt) + '</div>').join('') + '</div>';\n  const cmp = (aTitle, aBody, bTitle, bBody, aCls, bCls) =>\n    '<div class=\"cmp\"><div class=\"col ' + (aCls||'') + '\"><h6>' + esc(aTitle) + '</h6><pre>' + esc(aBody) + '</pre></div>' +\n    '<div class=\"col b ' + (bCls||'') + '\"><h6>' + esc(bTitle) + '</h6><pre>' + esc(bBody) + '</pre></div></div>';\n  function bars(rows) { return '<div class=\"bars\">' + rows.map((r) =>\n    '<div class=\"row\"><span class=\"lab\">' + esc(r.lab) + '</span><span class=\"track\">' +\n    '<span class=\"fill ' + (r.cls||'') + '\" style=\"width:' + Math.max(0, Math.min(100, r.pct)) + '%\"></span></span>' +\n    '<span class=\"val\">' + esc(r.val) + '</span></div>').join('') + '</div>'; }\n  function render(cmd, body, hint, viz) {\n    document.getElementById('cmd').textContent = cmd || '';\n    document.getElementById('viz').innerHTML = viz || '';\n    document.getElementById('app').innerHTML = body;\n    document.getElementById('hint').textContent = hint || '';\n  }\n</script>\n<script>\n  const q = '{{q}}';\n  const table = {\n    'vague': { t: '사용자가 왜 안 쓰지?', act: 1, ans: 1, narrow: 1 },\n    'vanity': { t: '누적 가입자는 몇 명?', act: 1, ans: 3, narrow: 2 },\n    'good': { t: '가입 3일 내 재방문율이 지난 분기보다 떨어졌나?', act: 3, ans: 3, narrow: 3 },\n    'why': { t: '이 기능이 매출에 도움 됐나?(무작위 실험)', act: 3, ans: 3, narrow: 3 },\n  };\n  const r = table[q];\n  const total = r.act + r.ans + r.narrow;\n  render('질문: 「' + r.t + '」  →  ' + total + '/9',\n    (total >= 8 ? '<span class=\"ok\">세 성질을 다 갖춘 좋은 질문 — 답이 행동으로 이어진다.</span>'\n      : total <= 4 ? '<span class=\"no\">셋 다 약함 — 좁히고, 데이터로 답 가능하게, 행동에 연결하라.</span>'\n      : '<span class=\"warn\">일부만 충족 — 약한 성질을 보강하라.</span>'),\n    '좋은 질문 = 행동으로 이어짐 + 데이터로 답 가능 + 범위 좁음.',\n    bars([\n      { lab: '행동으로 이어짐', pct: r.act / 3 * 100, val: r.act + '/3', cls: r.act >= 3 ? 'g' : 'b' },\n      { lab: '데이터로 답 가능', pct: r.ans / 3 * 100, val: r.ans + '/3', cls: r.ans >= 3 ? 'g' : 'b' },\n      { lab: '범위 좁음', pct: r.narrow / 3 * 100, val: r.narrow + '/3', cls: r.narrow >= 3 ? 'g' : 'b' },\n    ]));\n</script>",
