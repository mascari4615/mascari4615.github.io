          "text": "<style>\n  body { font: 13px/1.7 system-ui, sans-serif; margin:0; color:#e2e8f0; }\n  .wrap { background:#0b1220; border-radius:10px; padding:12px; }\n  .cmd { font:12.5px/1.7 ui-monospace, monospace; color:#7dd3fc; white-space:pre-wrap; }\n  pre { margin:6px 0 0; font:12px/1.65 ui-monospace, monospace; color:#cbd5e1; white-space:pre-wrap; }\n  .hint { font-size:12px; color:#94a3b8; margin-top:6px; }\n  .ok { color:#4ade80; } .no { color:#fca5a5; } .warn { color:#fbbf24; } .dim { color:#64748b; }\n  .arg { display:inline-block; background:#1e293b; border-radius:5px; padding:2px 7px; margin:2px 3px 2px 0;\n         font:12px ui-monospace, monospace; }\n  .arg.bad { background:#3b1d1d; color:#fca5a5; }\n  .arg.good { background:#14351f; color:#86efac; }\n</style>\n<div class=\"wrap\">\n  <div class=\"cmd\" id=\"cmd\"></div>\n  <div id=\"args\"></div>\n  <pre id=\"app\"></pre>\n  <div class=\"hint\" id=\"hint\"></div>\n</div>\n<script>\n  const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');\n  const chips = (list, cls) => list.map((a) =>\n    '<span class=\"arg ' + (cls || '') + '\">' + esc(a) + '</span>').join('');\n  function render(cmd, body, hint, args) {\n    document.getElementById('cmd').textContent = cmd ? '$ ' + cmd : '';\n    document.getElementById('args').innerHTML = args || '';\n    document.getElementById('app').innerHTML = body;\n    document.getElementById('hint').textContent = hint || '';\n  }\n</script>\n<script>\n  const c = '{{case}}';\n  const t = {\n    json: ['JSON 을 다뤄야 한다',\n      '<span class=\"warn\">경계</span> — jq 로 되면 셸, 구조를 만들고 바꿔야 하면 넘겨라.',\n      'curl … | jq -r \\'.items[].name\\'   <- 이 정도는 셸이 낫다'],\n    data: ['배열·딕셔너리로 자료를 다룬다',\n      '<span class=\"no\">넘길 때</span> — bash 배열은 중첩이 안 되고 문법이 험하다.',\n      '자료 구조가 나오면 그때가 신호다.'],\n    len: ['200줄이 넘고 함수가 열 개다',\n      '<span class=\"no\">넘길 때</span> — 테스트도 어렵고 읽기도 어렵다.',\n      '길이보다 「테스트를 쓰고 싶은가」가 더 정확한 기준이다.'],\n    glue: ['명령 대여섯 개를 순서대로 잇는다',\n      '<span class=\"ok\">셸이 맞다</span> — 파이썬으로 옮기면 subprocess 로 더 길어진다.',\n      '이런 일에 셸을 이길 언어는 없다.'],\n    port: ['윈도우에서도 돌아야 한다',\n      '<span class=\"no\">넘길 때</span> — 셸 스크립트는 옮기기 어렵다.',\n      'Node·Python 이면 그대로 돈다. 팀 환경이 섞여 있으면 처음부터 그쪽으로.'],\n  }[c];\n  render('', '  <span class=\"dim\">' + esc(t[0]) + '</span>\\n\\n  ' + t[1] + '\\n\\n  ' + esc(t[2]),\n    '기준 한 줄: 명령을 잇는 일이면 셸, 자료를 다루는 일이면 프로그래밍 언어.');\n</script>",
