          "height": "300px",
          "text": "<style>\n  body { font: 14px/1.7 system-ui, sans-serif; margin: 0; color: #e2e8f0; }\n  .panel { background:#0b1220; border-radius:10px; padding:12px; }\n  button { font: inherit; padding:6px 12px; border-radius:8px; border:1px solid #334155;\n           background:#1e293b; color:#e2e8f0; cursor:pointer; }\n  button:hover { border-color:#60a5fa; }\n  input { font: inherit; padding:6px 10px; border-radius:8px; border:1px solid #334155;\n          background:#0f172a; color:#e2e8f0; }\n  ul { list-style:none; padding:0; margin:8px 0 0; }\n  li { display:flex; gap:8px; align-items:center; padding:6px 8px; background:#111c33; border-radius:8px; margin-bottom:6px; }\n  .log { font: 12.5px/1.6 ui-monospace, monospace; color:#94a3b8; white-space:pre-wrap; margin-top:8px; }\n  .hint { font-size:12.5px; color:#94a3b8; }\n</style>\n<div class=\"panel\">\n  <form id=\"f\">\n    <p><input name=\"q\" placeholder=\"검색어를 쳐 보라\" style=\"width:100%\"></p>\n    <p><label><input type=\"checkbox\" name=\"only\" checked> 재고만</label>\n       <select name=\"sort\"><option value=\"new\">최신</option><option value=\"cheap\">저렴</option></select></p>\n    <button>보내기</button>\n  </form>\n  <div class=\"log\" id=\"log\"></div>\n</div>\n<script>\n  const wait = {{wait}};\n  const f = document.getElementById('f'), log = document.getElementById('log');\n  let inputN = 0, changeN = 0, callN = 0, timer;\n  const dump = () => Object.fromEntries(new FormData(f));\n  const draw = () => { log.textContent =\n    'FormData: ' + JSON.stringify(dump()) +\n    '\\ninput 이벤트 ' + inputN + '번 · change 이벤트 ' + changeN + '번' +\n    '\\n실제 서버를 부른 횟수(디바운스 ' + wait + 'ms): ' + callN; };\n  f.addEventListener('input', () => {\n    inputN++; draw();\n    clearTimeout(timer);\n    timer = setTimeout(() => { callN++; draw(); }, wait);\n  });\n  f.addEventListener('change', () => { changeN++; draw(); });\n  f.addEventListener('submit', (e) => { e.preventDefault(); log.textContent = '보냄: ' + JSON.stringify(dump()); });\n  draw();\n</script>",
          "controls": [
            {
              "id": "wait",
              "label": "디바운스(ms)",
