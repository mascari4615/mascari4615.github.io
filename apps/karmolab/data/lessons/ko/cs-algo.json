 { dp[v] = dp[v - c] + 1; from[v] = c; }\n  const best = []; let v = TARGET;\n  while (v > 0 && from[v] > 0) { best.push(from[v]); v -= from[v]; }\n  const same = greedy.length === best.length;\n  app.innerHTML = '<div class=\"hint\">동전 [' + coins.join(', ') + '] 으로 ' + TARGET + ' 만들기</div>';\n  show('탐욕(큰 것부터)  ' + greedy.length + '개  ' + JSON.stringify(greedy) + (rest ? '  (남음 ' + rest + ')' : '') + '\\n'\n     + '동적 계획(최적)  ' + best.length + '개  ' + JSON.stringify(best) + '\\n\\n'\n     + (same ? '이 동전 체계에서는 탐욕이 맞는다 (한국 동전은 그런 성질을 가진다).'\n             : '탐욕이 틀렸다. [4,3,1] 로 6 을 만들면 4+1+1(3개)를 고르지만 3+3(2개)이 답이다.'));\n</script>",
