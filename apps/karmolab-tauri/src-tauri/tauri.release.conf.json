{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KarmoLab",
  "identifier": "com.mascari4615.karmolab",
  "build": {
    "frontendDist": "https://mascari4615.github.io/karmolab/",
    "devUrl": "http://127.0.0.1:8899/apps/karmolab/"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "label": "main",
        "title": "KarmoLab",
        "width": 1100,
        "height": 800,
        "resizable": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/karmolab-life-ml"],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": { "compression": "lzma" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
