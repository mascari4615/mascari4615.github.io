{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "KarmoLab webview (embedded _site or remote): invoke desktop_notify; main window. shell:allow-open = 웹 즐겨찾기(target=_blank). shell 플러그인이 바깥 링크 클릭을 가로채 plugin:shell|open 으로 넘기므로 이 열쇠가 없으면 사이트 칸이 아무 반응도 안 한다 (Rust on_new_window 폴백은 플러그인이 먼저 가로채 닿지 않는다).",
  "windows": [
    "main",
    "alarm",
    "files"
  ],
  "remote": {
    "urls": [
      "https://blog.mascari4615.com/*",
      "https://files.mascari4615.com/*",
      "https://mascari4615.github.io/*",
      "http://127.0.0.1:8898/*",
      "http://127.0.0.1:8899/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "allow-desktop-notify",
    "allow-desktop-login",
    "allow-localdev",
    "allow-repofile",
    "allow-karmolab-update",
    "allow-karmolab-release",
    "allow-activity",
    "allow-questlog-hub",
    "allow-life-screen",
    "allow-life-features",
    "allow-quest-index",
    "allow-quest-writeback",
    "allow-task-launcher",
    "allow-terminal",
    "allow-adventure",
    "allow-recall",
    "allow-claude-env",
    "allow-alarm",
    "allow-agent-team",
    "allow-cockpit",
    "allow-ai-quota",
    "allow-ai-environment",
    "allow-parts",
    "allow-app-launcher",
    "dialog:allow-open",
    "shell:allow-open",
    "updater:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/karmolab-life-ml",
          "sidecar": true
        }
      ]
    },
    "allow-vault-upload",
    "allow-vault-open",
    "allow-files-window"
  ]
}
