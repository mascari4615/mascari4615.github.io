# ── Jekyll / Ruby ────────────────────────────────────────────────────────────
.bundle
vendor/
Gemfile.lock
*.gem
_site/
_site_test/
.jekyll-cache/
.jekyll-metadata
_sass/vendors/

# ── Node / env ───────────────────────────────────────────────────────────────
node_modules/
.env
.env.*
!.env.example
!.env.template
.karmolab.common.env
.discord-bots.env
.yawnbot.env
.yawnbot.kakao.env

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/blog.code-snippets

# ── Build artifacts ──────────────────────────────────────────────────────────
# karmolab-ai
packages/karmolab-ai/dist/

# KarmoLab React (apps/karmolab)
apps/karmolab/react-dist/

# KarmoWorld scripts (built from src/world/*.ts; wiki *.md stay tracked)
apps/karmolab/world/*.js

# KarmoLab TS build output (esbuild via npm run build).
# Root scripts + widgets/**/*.js = generated. Tracked legacy .js under widgets/ is unchanged
# until migrated (gitignore does not apply to already-tracked files). json/md stay visible.
# KarmoLab 의 js 는 전부 빌드 산출물이다 (소스는 apps/karmolab/src). 하나씩 적어 두었더니
# 새 파일을 만들 때마다 빠뜨렸고, 다른 작업이 이 목록을 덮으며 지워지기도 했다 (TASK-KL-098).
# 규칙 하나로 바꾼다 — 남이 만든 vendor 와 손으로 쓴 스크립트만 예외로 남긴다.
apps/karmolab/js/**/*.js
!apps/karmolab/js/vendor/**
!apps/karmolab/js/split_script.cjs
apps/karmolab/sw.js

# 글꼴 원본 (TASK-KL-128) — 34MB 짜리 통짜 글꼴이다. `scripts/gen-fonts.py` 가 필요할 때 받아 온다.
# 잘라 낸 결과(apps/karmolab/fonts/*.woff2)는 배포에 나가야 하므로 **저장소에 담는다**.
apps/karmolab/.fontsrc/

# KarmoLab Jekyll 진입 페이지 — 배포 시 apps/karmolab/index.html 복사 +
# scripts/gen-tool-pages.mjs 가 t/<id>/ 도구 페이지를 찍는 자리 (TASK-KL-088)
apps/blog/karmolab/

# 「오늘의 하나 맞히기」 — 배포 시 apps/daily/dist/ 가 복사되는 자리 (TASK-KAR-202)
apps/blog/daily/
apps/daily/dist/
apps/daily/.cache/

# Blog theme bundles (Rollup + PurgeCSS: npm run build)
assets/js/dist/
assets/js/graph-view/

# ── YawnBot 런타임 state ─────────────────────────────────────────────────────
# deploy git clean -fd 가 untracked 을 삭제하므로 ignored 라야 survive.
# 글롭 = 새 notifier 가 같은 함정 반복 안 하게. TASK-YB-007 / YB-027.
apps/discord-bots/apps/yawnbot/data/*-state.json

# 채널 프로비저닝 파생 ID 맵 (정본=channel-spec.json, 본 파일=길드별 런타임 캐시).
apps/discord-bots/apps/yawnbot/data/provisioned-channels.*.json

# 폰이 밀어 넣은 실행 로그 (TASK-WM-201). 런타임 산출물 — 커밋 대상 아님.
apps/discord-bots/apps/yawnbot/data/device-logs/

# ── System / OS ──────────────────────────────────────────────────────────────
*~
.DS_Store
Thumbs.db
*.stackdump

# 폰 점검 스크린샷 (scripts/shoot-mobile.mjs) — 로컬 산출물
apps/karmolab/.mobile-shots/
