.jekyll-cache/
.jekyll-metadata/
node_modules/
vendor/
_sass/vendors
# Theme JS/CSS bundles (Rollup + PurgeCSS: `npm run build`)
assets/js/dist
# Post graph tab bundle (Rollup: `npm run build`)
assets/js/graph-view/

# YawnBot 런타임 dedup state (deploy git clean -fd 가 untracked 지움 → ignored 라야
# survive). 글롭 = 새 notifier 가 같은 함정 반복 안 하게. TASK-YB-007 / YB-027 재발.
apps/discord-bots/apps/yawnbot/data/*-state.json

# 채널 프로비저닝 파생 ID 맵 (정본=channel-spec.json, 본 파일=길드별 런타임 캐시).
apps/discord-bots/apps/yawnbot/data/provisioned-channels.*.json

