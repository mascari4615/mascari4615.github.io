# ── Jekyll / Ruby ────────────────────────────────────────────────────────────
.bundle
vendor/
# three-kit 의 vendor 는 배포에 실려야 한다 — three.js 한 벌을 저장소가 든다 (KL-345).
# 전역 vendor/ 제외 안의 재포함은 폴더부터 살려야 파일 줄이 듣는다.
!packages/three-kit/vendor/
!packages/three-kit/vendor/**
Gemfile.lock
*.gem
_site/
_site_test/
.jekyll-cache/
.jekyll-metadata
_sass/vendors/

# ── Node / env ───────────────────────────────────────────────────────────────
node_modules/
.env
.env.*
!.env.example
!.env.template
.karmolab.common.env
.discord-bots.env
.yawnbot.env
.yawnbot.kakao.env

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/blog.code-snippets

# ── Build artifacts ──────────────────────────────────────────────────────────
# karmolab-ai
packages/karmolab-ai/dist/

# KarmoWorld scripts (built from src/world/*.ts; wiki *.md stay tracked)
apps/karmolab/world/*.js

# KarmoLab TS build output (esbuild via npm run build).
# Root scripts + widgets/**/*.js = generated. Tracked legacy .js under widgets/ is unchanged
# until migrated (gitignore does not apply to already-tracked files). json/md stay visible.
# KarmoLab 의 js 는 전부 빌드 산출물이다 (소스는 apps/karmolab/src). 하나씩 적어 두었더니
# 새 파일을 만들 때마다 빠뜨렸고, 다른 작업이 이 목록을 덮으며 지워지기도 했다 (TASK-KL-098).
# 규칙 하나로 바꾼다 — 남이 만든 vendor 와 손으로 쓴 스크립트만 예외로 남긴다.
apps/karmolab/js/**/*.js
!apps/karmolab/js/vendor/**
!apps/karmolab/js/split_script.cjs
# 묶어 쓰기가 그때 받는 알맹이들 — `build.mjs` 가 찍는다 (TASK-KL-205, 2026-08-13).
# 도구마다 한 파일이라 서른여덟 개가 생긴다. 소스는 `src/core/*.ts` 하나뿐이다.
apps/karmolab/core/*.js
# 오락실이 누를 때 받는 게임 조각들 — `build.mjs` 가 찍는다 (TASK-KL-242, 2026-08-14).
# 게임 하나가 파일 하나라 쉰한 개가 생긴다. 소스는 `src/widgets/arcade/games/*.ts` 다.
apps/karmolab/arcade/games/*.js
# 같은 조각의 **입체 표현** — 3D 로 볼 때만 받는다. 소스는 `games/*-view3d.ts`.
apps/karmolab/arcade/games3d/*.js
apps/karmolab/sw.js

# 손 인식 연장 (change.motion-3d-cores) — wasm 12MB + 손 모델 7MB. `npm run fetch:hand` 로 받는다.
# 글꼴 원본과 같은 규칙: **큰 원본은 받아 오고 저장소엔 안 담는다**. 안 받으면 손 조작만 안 켜진다.
apps/karmolab/.handsrc/

# 글꼴 원본 (TASK-KL-128) — 34MB 짜리 통짜 글꼴이다. `scripts/gen-fonts.py` 가 필요할 때 받아 온다.
# 잘라 낸 결과(apps/karmolab/fonts/*.woff2)는 배포에 나가야 하므로 **저장소에 담는다**.
apps/karmolab/.fontsrc/

# KarmoLab Jekyll 진입 페이지 — 배포 시 apps/karmolab/index.html 복사 +
# scripts/gen-tool-pages.mjs 가 t/<id>/ 도구 페이지를 찍는 자리 (TASK-KL-088)
apps/blog/karmolab/

# 언어 판 — `gen-locale-pages` · `gen-tool-pages-locale` 이 배포 때 찍는 자리 (TASK-KL-203).
# 한국어 판(`apps/blog/karmolab/`)과 똑같이 **산출물**이다: 번역 파일(`apps/karmolab/i18n/`)과
# 생성기가 정본이고, 이 폴더는 매 배포마다 새로 만들어진다. 커밋하면 260장이 저장소에 눌러앉아
# 원본과 갈라진다 — 갈라진 사본은 아무도 안 고치고 조용히 낡는다.
apps/blog/en/
apps/blog/ja/

# 블로그 글 정본 = `apps/karmolab/content/{posts,drafts,about.md}` (git 추적 — 컷오버로 승격,
# change.blog-cutover). `content/pages/` 만 산출물이다: `gen:post-pages` 가 검증용으로 찍는 자리.
apps/karmolab/content/pages/

# 블로그 정적 장 산출물 — `gen:post-pages` 가 배포마다 새로 찍어 apps/blog 로 복사된다
# (change.blog-cutover). 색인은 rsync 로 /apps/karmolab/data/ 에 실려 커뮤니티 「글」 탭이 읽는다.
apps/karmolab/data/posts-index.json
# 「비슷한 글」 — 색인에서 파생된다 (`npm run gen:related`). 곳간도 이 기계 것이다.
apps/karmolab/data/related-posts.json
apps/karmolab/data/.related-cache.json
apps/blog/posts/
apps/blog/feed.xml
apps/blog/index.html
apps/blog/about/
apps/blog/works/
apps/blog/404.html
apps/blog/assets/js/data/post-graph.json

# 「오늘의 하나 맞히기」 — 배포 시 apps/daily/dist/ 가 복사되는 자리 (TASK-KAR-202)
apps/blog/daily/
apps/daily/dist/
apps/daily/.cache/

# Blog theme bundles (Rollup + PurgeCSS: npm run build)
assets/js/dist/
assets/js/graph-view/

# ── YawnBot 런타임 state ─────────────────────────────────────────────────────
# deploy git clean -fd 가 untracked 을 삭제하므로 ignored 라야 survive.
# 글롭 = 새 notifier 가 같은 함정 반복 안 하게. TASK-YB-007 / YB-027.
apps/discord-bots/apps/yawnbot/data/*-state.json

# 채널 프로비저닝 파생 ID 맵 (정본=channel-spec.json, 본 파일=길드별 런타임 캐시).
apps/discord-bots/apps/yawnbot/data/provisioned-channels.*.json

# 폰이 밀어 넣은 실행 로그 (TASK-WM-201). 런타임 산출물 — 커밋 대상 아님.
apps/discord-bots/apps/yawnbot/data/device-logs/

# 봇이 받아 둔 것 — 사람이 올린 그림, 알림 상태. 전부 런타임 산출물이다.
# **이 저장소는 공개다.** 올린 그림이 담기면 그대로 인터넷에 올라간다.
# 디렉토리째 막는다 — 새 종류가 하나 늘 때마다 다시 뚫리지 않게.
apps/discord-bots/apps/data/

# ── System / OS ──────────────────────────────────────────────────────────────
*~
.DS_Store
Thumbs.db
*.stackdump

# 폰 점검 스크린샷 (scripts/shoot-mobile.mjs) — 로컬 산출물
apps/karmolab/.mobile-shots/

# KarmoLab 셸 스타일 두 벌 — `scripts/split-css.mjs` 가 `css/toolbox.css` 에서 뽑는다 (TASK-KL-128).
# 정본은 toolbox.css 한 장이므로 뽑은 것은 담지 않는다.
apps/karmolab/css/shell-critical.css
apps/karmolab/css/shell-deferred.css

# 내용 지문이 박힌 사본 + 그 표 — `scripts/stamp-assets.mjs` 가 배포 때 만든다 (TASK-KL-128).
apps/karmolab/js/asset-manifest.json
apps/karmolab/css/*.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].css

# 판 표식 — `build.mjs` 가 남기고 생성기가 읽는다 (TASK-KL-128).
apps/karmolab/.build-stamp
# 「올린 것이 실제로 서빙되나」를 물어보려고 빌드가 내놓는 표식 (TASK-KL-124)
apps/karmolab/build.json

# 세션이 잠깐 쓰고 버리는 것들 — 안 적어 두면 「안 담긴 작업」처럼 보여 남이 담아 버린다 (KAR-204).
# 실제로 오늘 이런 임시 파일 여섯 개가 사라진 뒤에야 임시였다는 걸 알았다.
.wt-*/
**/.*.tmp.mjs
apps/karmolab/.kl-*.mjs
apps/karmolab/*.png
apps/karmolab/live-check-red.txt

# 모든 Temp, Tmp
**/Temp/
**/temp/
**/Tmp/
**/tmp/

# 검사 판을 「긴 것부터」 세우려고 지난 판 시간을 적어 두는 자리 — 판마다 바뀌는 캐시라 담지 않는다.
apps/karmolab/data/gate-times.json

# ── Unity (apps/handheld/unity — TASK-KAR-230) ───────────────────────────────
apps/handheld/unity/[Ll]ibrary/
apps/handheld/unity/[Tt]emp/
apps/handheld/unity/[Oo]bj/
apps/handheld/unity/[Bb]uild/
apps/handheld/unity/[Bb]uilds/
apps/handheld/unity/[Ll]ogs/
apps/handheld/unity/[Uu]ser[Ss]ettings/
apps/handheld/unity/[Mm]emoryCaptures/
apps/handheld/unity/*.csproj
apps/handheld/unity/.vscode/
apps/handheld/unity/*.sln
# 헤드리스 시험 결과 — 돌릴 때마다 새로 나오는 판이라 담지 않는다.
apps/handheld/unity/TestResults.xml
apps/handheld/unity/PlayResults.xml
apps/handheld/unity/HandheldLogs/
# 테스트 씬은 HandheldSetup.BuildScene() 이 코드로 짓는다 (조종석이 없으면 자동으로 짓는다).
# 바닥 타일 169개가 통째로 직렬화돼 2만 줄이 넘는다 — 파생물이라 담지 않는다.
apps/handheld/unity/Assets/Scenes/
apps/handheld/unity/Assets/Scenes.meta
# 포즈 기록 — 진단용으로 그때그때 찍는 것이라 저장소에 남기지 않는다.
apps/handheld/unity/HandheldLogs/

# 유니티 패키지의 `Documentation~` 는 편집기 백업이 아니라 **정식 폴더**다
# (끝의 ~ = 「임포터는 보지 마라」 표시). 위의 `*~` 가 통째로 삼키므로 예외를 판다.
!**/Documentation~/
!**/Documentation~/**

# ── 지형도(atlas) — 비공개 지식베이스 파생물 ─────────────────────────────────
# 좌표·이웃만으로도 갈래 복원 72.5% — 제목을 가려도 안 지켜진다(bookmark-terrain 실측).
# audit-private-origin 게이트가 이중으로 막지만, 여기서도 명시로 못 들어가게 한다.
# atlas.sources.json 은 소스(비공개 폴더 경로) 정의라 같이 뺀다.
apps/karmolab/data/memo-atlas.json
apps/karmolab/data/.memo-atlas-*.json
apps/karmolab/data/.link-bodies.json
apps/karmolab/data/atlas.sources.json

# 글 사진은 R2(img.mascari4615.com)가 정본 서빙 — git 은 더 안 든다 (change.board-unify).
# 사본: R2 + C:\Users\masca\Backups\blog-images-2026-08-23\ zip + git 역사(재작성 전까지).
apps/blog/assets/img/post/

# Files 전송기 진행 상태 (기계 하나짜리 · 집계 수치뿐)
apps/files/.upload-progress.json
apps/files/.upload-*.log
