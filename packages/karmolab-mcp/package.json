    "model-context-protocol",
    "korea",
    "korean",
    "hash",
    "uuid",
    "holidays",
    "hangul",
    "converter",
    "tools"
  ],
  "license": "MIT",
  "author": "Mascari4615",
  "homepage": "https://blog.mascari4615.com/karmolab/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mascari4615/Mascari4615.github.io.git",
    "directory": "packages/karmolab-mcp"
  },
  "bugs": {
    "url": "https://github.com/Mascari4615/Mascari4615.github.io/issues"
  },
  "bin": {
    "karmolab-mcp": "src/server.mjs"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
