{
  "name": "companion",
  "version": "0.1.0",
  "private": true,
  "description": "동반자 코어 — 감각·판단·두뇌·기억·표현 5개 자리를 갈아끼우는 뼈대. 인격 없음 (TASK-KAR-201)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "demo": "npm run build && node demo/run.mjs",
    "face": "npm run build && node demo/face.mjs",
    "page": "npm run build && node demo/launch.mjs",
    "page:talk": "npm run build && node demo/launch.mjs talk",
    "page:grok": "npm run build && node demo/launch.mjs grok",
    "page:preview": "npm run build && node demo/launch.mjs preview",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "fflate": "^0.8.3",
    "@karmo/ai": "file:../@karmo/ai",
    "msedge-tts": "^2.0.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.62.1",
    "typescript": "~5.9.0"
  }
}
